# Copy this file to .env and adjust what you need.
# Most variables are optional. Two are required for real use:
#   VIDEO_RAG_JINA_API_KEY  multilingual embeddings (indexing + retrieval)
#   VIDEO_RAG_LLM_API_KEY   answer writing (the backend refuses to start without it)
# The offline defaults below still run the test suite and `run.ps1 smoke`
# against stub adapters with no keys and no network.
# Never commit a real .env file.

# --- Runtime ----------------------------------------------------------------
VIDEO_RAG_ENVIRONMENT=development           # development | production | test
VIDEO_RAG_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
VIDEO_RAG_LOG_JSON=true                     # structured logs, recommended in production
VIDEO_RAG_DATA_DIR=data                     # SQLite registry, local vectors, audio cache
VIDEO_RAG_PIPELINE_VERSION=v1               # bump to force a re-index after pipeline changes

# --- HTTP API ---------------------------------------------------------------
VIDEO_RAG_API_HOST=127.0.0.1
VIDEO_RAG_API_PORT=8000
# Comma separated. Requests must send one of these in the X-API-Key header.
# Production refuses to start without keys unless ALLOW_ANONYMOUS is true.
VIDEO_RAG_API_KEYS=
VIDEO_RAG_ALLOW_ANONYMOUS=false
# Comma separated exact origins. A wildcard is rejected in production.
VIDEO_RAG_CORS_ORIGINS=
VIDEO_RAG_RATE_LIMIT_PER_MINUTE=60
VIDEO_RAG_MAX_QUESTION_CHARACTERS=500
VIDEO_RAG_JOB_RETENTION_SECONDS=3600
# Folder with the web page. Leave as is to open the UI at the API address.
VIDEO_RAG_FRONTEND_DIR=frontend

# --- Ingestion --------------------------------------------------------------
VIDEO_RAG_INGEST_CONCURRENCY=6               # parallel videos; keep low to avoid HTTP 429
VIDEO_RAG_MAX_VIDEOS_PER_COURSE=500
VIDEO_RAG_MAX_VIDEO_DURATION_SECONDS=21600
VIDEO_RAG_TRANSCRIPT_RETRY_ATTEMPTS=3
VIDEO_RAG_TRANSCRIPT_RETRY_BASE_DELAY=1.0
# Caption languages to look for, most preferred first, for example: en,hi
VIDEO_RAG_CAPTION_LANGUAGES=en
# If none of those exist, index the original language instead of skipping.
VIDEO_RAG_CAPTION_ANY_LANGUAGE=true
VIDEO_RAG_HTTP_TIMEOUT_SECONDS=30.0
# Catalog backend: ytdlp (no key, scraping) or youtube_data_api (official,
# needs YOUTUBE_API_KEY below). Data API covers titles/durations/listing;
# transcripts still use captions/ASR, audio still uses yt-dlp.
VIDEO_RAG_CATALOG_BACKEND=ytdlp
VIDEO_RAG_YOUTUBE_API_KEY=

# --- Chunking ---------------------------------------------------------------
VIDEO_RAG_CHUNK_WINDOW_SECONDS=60
VIDEO_RAG_CHUNK_OVERLAP_SECONDS=15           # must be smaller than the window
VIDEO_RAG_MIN_CHUNK_CHARACTERS=80

# --- Embeddings (Jina hosted API, multilingual; key required) ---------------
# Switching models invalidates old vectors: wipe data/ and re-index.
VIDEO_RAG_EMBEDDING_DIMENSION=1024           # 1024 for jina-embeddings-v3
VIDEO_RAG_EMBEDDING_BATCH_SIZE=32
# Get a key at https://jina.ai (free credit included).
VIDEO_RAG_JINA_API_KEY=
VIDEO_RAG_JINA_MODEL=jina-embeddings-v3
VIDEO_RAG_JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

# --- Vector store -----------------------------------------------------------
# memory: local JSON file, good for development. qdrant: production backend.
VIDEO_RAG_VECTOR_BACKEND=memory
VIDEO_RAG_QDRANT_URL=
VIDEO_RAG_QDRANT_API_KEY=
VIDEO_RAG_QDRANT_COLLECTION=chunks

# --- Retrieval and the coverage gate ---------------------------------------
# Lexical rerank of the fused top 30 down to RERANK_TOP_K.
VIDEO_RAG_RETRIEVE_TOP_K=30
VIDEO_RAG_RERANK_TOP_K=8                     # cannot exceed RETRIEVE_TOP_K
VIDEO_RAG_FUSION_K=60
# IMPORTANT: these two are placeholders. Calibrate them on your own labelled
# set with eval/run_eval.py before trusting the refusal behaviour.
VIDEO_RAG_THRESHOLD_HIGH=0.55
VIDEO_RAG_THRESHOLD_LOW=0.15
VIDEO_RAG_LAMBDA_COVERAGE=0.3                # breadth bonus when ranking videos
VIDEO_RAG_LEAD_IN_SECONDS=3                  # seek slightly before the sentence

# --- Transcript post-processing --------------------------------------------
VIDEO_RAG_PUNCTUATION_ENABLED=false
VIDEO_RAG_PUNCTUATION_MODEL=kredor/punctuate-all
VIDEO_RAG_TERMINOLOGY_CORRECTION_ENABLED=false

# --- Language model (REQUIRED: writes answers, verifies gray zone) ---------
# Top-k chunks + question -> one chat API call -> answer.
# Any OpenAI-compatible chat endpoint works, for example Groq:
#   VIDEO_RAG_LLM_BASE_URL=https://api.groq.com/openai/v1
VIDEO_RAG_LLM_BASE_URL=https://api.openai.com/v1
VIDEO_RAG_LLM_MODEL=gpt-4o-mini
VIDEO_RAG_LLM_API_KEY=
VIDEO_RAG_LLM_TIMEOUT_SECONDS=30.0
VIDEO_RAG_LLM_MAX_OUTPUT_TOKENS=600

# --- Answer wording --------------------------------------------------------
VIDEO_RAG_REFUSAL_MESSAGE=The topic is not covered in the given course
